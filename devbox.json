{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "rustc@1.90.0",
    "cargo@1.90.0",
    "rustfmt@1.90.0",
    "clippy@1.90.0",
    "rust-analyzer@2025-02-10",
    "cargo-edit@0.13.4",
    "jq@1.7.1",
    "git@2.54.0"
  ],
  "nixpkgs": {
    "commit": "329c3d2af6d1b618705150ea39f72c15eb4e613e"
  },
  "shell": {
    "scripts": {
      "build":         "cargo build",
      "build-release": "cargo build --release",
      "run":           "cargo run",
      "migrate":       "cargo run -- migrate",
      "test":          "cargo test",
      "fmt":           "cargo fmt",
      "fmt-check":     "cargo fmt --check",
      "lint":          "cargo clippy --all-targets --all-features -- -D warnings",
      "check":         "set -e; cargo fmt --check; cargo clippy --all-targets --all-features -- -D warnings; cargo test"
    }
  }
}
