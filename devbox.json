{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "rustup@1.28.2",
    "postgresql@17",
    "git@latest",
    "curl@latest",
    "openssl@latest",
    "pkg-config@latest"
  ],
  "shell": {
    "scripts": {
      "run": "cargo run",
      "fmt": "cargo fmt --all",
      "check": "cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings && cargo test --all-targets --all-features",
      "test": "cargo test --all-targets --all-features",
      "build": "cargo build --release"
    }
  }
}
