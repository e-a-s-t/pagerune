# Copy to .env; load with direnv allow. No application dotenv loader is used.
# Runtime settings implemented in this scaffold:
PAGERUNE_BIND=127.0.0.1:8080
POSTGRES_DB=pagerune
POSTGRES_USER=pagerune
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://pagerune:local-development-only@127.0.0.1:5432/pagerune
RUST_LOG=pagerune=debug,tower_http=info

# Planned settings; documented now, not consumed by the HTTP skeleton yet:
PAGERUNE_PUBLIC_BASE_URL=http://localhost:8080
PAGERUNE_DIGEST_TIME=18:00
PAGERUNE_TIMEZONE=Europe/Stockholm
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=updates@localhost
SMTP_FROM_NAME=PageRune
OIDC_ISSUER_URL=https://sso.example.com/realms/pagerune
OIDC_CLIENT_ID=pagerune
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=pagerune-api
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
