# Copy to .env; load with direnv allow. No application dotenv loader is used.
# Runtime settings:
PAGERUNE_BIND=127.0.0.1:8080
PAGERUNE_DEV_API_ENABLED=true
PAGERUNE_FETCH_TIMEOUT_SECONDS=15
PAGERUNE_MAX_RESPONSE_BYTES=2097152
PAGERUNE_TOKEN_KEY=
PAGERUNE_TURNSTILE_SITE_KEY=
PAGERUNE_TURNSTILE_SECRET=
PAGERUNE_TURNSTILE_TEST_MODE=true
POSTGRES_DB=pagerune
POSTGRES_USER=pagerune
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://pagerune:local-development-only@127.0.0.1:5432/pagerune
RUST_LOG=pagerune=debug,tower_http=info

# Public origin used to build subscription, verification, management, and unsubscribe links.
PAGERUNE_PUBLIC_BASE_URL=http://localhost:8080
PAGERUNE_EMAIL_TEMPLATE_DIR=templates/email
# Planned daily cycle settings:
PAGERUNE_DIGEST_TIME=18:00
PAGERUNE_TIMEZONE=Europe/Stockholm
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=updates@localhost
SMTP_FROM_NAME=PageRune
SMTP_TIMEOUT_SECONDS=15
PAGERUNE_NOTIFICATION_CONCURRENCY=2
PAGERUNE_NOTIFICATION_MAX_ATTEMPTS=8
OIDC_ISSUER_URL=https://sso.example.com/realms/pagerune
OIDC_CLIENT_ID=pagerune
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=pagerune-api
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
